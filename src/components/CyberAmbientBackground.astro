<!-- Full-page cyber ambience layer used behind the portfolio shell. -->
<div class="cyber-ambient" aria-hidden="true">
  <canvas id="cyber-ambient-canvas"></canvas>
  <div class="cyber-vignette"></div>
  <div class="cyber-grid"></div>
</div>

<script is:inline>
  // Canvas particle field; decorative only and disabled for non-canvas contexts.
  document.addEventListener("DOMContentLoaded", () => {
    const canvas = document.getElementById("cyber-ambient-canvas");
    if (!(canvas instanceof HTMLCanvasElement)) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);

    const glyphPool = "010101101001+<>[]{}$#".split("");

    const particles = Array.from({ length: 28 }, () => ({
      x: 0,
      y: 0,
      char: "0",
      size: 12,
      alpha: 0,
      life: 0,
      maxLife: 0,
      driftX: 0,
      driftY: 0,
      glow: 0,
    }));

    function resetParticle(p) {
      p.x = Math.random() * width;
      p.y = Math.random() * height;
      p.char = glyphPool[Math.floor(Math.random() * glyphPool.length)];
      p.size = 10 + Math.random() * 10;
      p.alpha = 0;
      p.life = 0;
      p.maxLife = 120 + Math.random() * 180;
      p.driftX = (Math.random() - 0.5) * 0.15;
      p.driftY = -0.05 - Math.random() * 0.18;
      p.glow = 6 + Math.random() * 10;
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;

      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = width + "px";
      canvas.style.height = height + "px";

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      particles.forEach(resetParticle);
    }

    function drawBackgroundGlow(time) {
      const pulse = 0.5 + Math.sin(time * 0.0006) * 0.08;

      const grad1 = ctx.createRadialGradient(
        width * 0.18,
        height * 0.25,
        0,
        width * 0.18,
        height * 0.25,
        280,
      );
      grad1.addColorStop(0, `rgba(120,255,80,${0.045 * pulse})`);
      grad1.addColorStop(1, "rgba(120,255,80,0)");

      const grad2 = ctx.createRadialGradient(
        width * 0.82,
        height * 0.72,
        0,
        width * 0.82,
        height * 0.72,
        320,
      );
      grad2.addColorStop(0, `rgba(80,255,140,${0.03 * pulse})`);
      grad2.addColorStop(1, "rgba(80,255,140,0)");

      ctx.fillStyle = grad1;
      ctx.fillRect(0, 0, width, height);

      ctx.fillStyle = grad2;
      ctx.fillRect(0, 0, width, height);
    }

    function animate(time) {
      ctx.clearRect(0, 0, width, height);

      drawBackgroundGlow(time);

      for (const p of particles) {
        p.life += 1;
        const progress = p.life / p.maxLife;

        if (progress < 0.2) {
          p.alpha = progress / 0.2;
        } else if (progress > 0.75) {
          p.alpha = Math.max(0, (1 - progress) / 0.25);
        } else {
          p.alpha = 1;
        }

        p.x += p.driftX;
        p.y += p.driftY;

        if (p.life >= p.maxLife || p.y < -30 || p.x < -30 || p.x > width + 30) {
          resetParticle(p);
          p.y = Math.random() * height;
        }

        ctx.save();
        ctx.globalAlpha = p.alpha * 0.22;
        ctx.fillStyle = "#b6ff00";
        ctx.shadowColor = "#b6ff00";
        ctx.shadowBlur = p.glow;
        ctx.font = `${p.size}px JetBrains Mono, monospace`;
        ctx.fillText(p.char, p.x, p.y);
        ctx.restore();
      }

      requestAnimationFrame(animate);
    }

    resize();
    window.addEventListener("resize", resize);
    requestAnimationFrame(animate);
  });
</script>

<style>
  /* Ambient canvas, vignette, and low-contrast grid backdrop. */
  .cyber-ambient {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  #cyber-ambient-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 1;
  }

  .cyber-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at center,
      transparent 45%,
      rgba(0, 0, 0, 0.35) 100%
    );
  }

  .cyber-grid {
    position: absolute;
    inset: 0;
    opacity: 0.04;
    background-image:
      linear-gradient(rgba(182, 255, 0, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(182, 255, 0, 0.12) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(circle at center, black 35%, transparent 90%);
    -webkit-mask-image: radial-gradient(
      circle at center,
      black 35%,
      transparent 90%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    #cyber-ambient-canvas {
      opacity: 0.45;
    }
  }
</style>
