---
// Shared modal frame used by project detail dialogs.
interface Props {
  title: string;
  tagline?: string;
  onClose?: string;
}

const { title, tagline } = Astro.props;
---

<div class="overlay" data-close></div>

<!-- ProjectSection listens for data-close clicks to dismiss the active modal. -->
<div
  class="modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  aria-describedby="modal-desc"
>
  <button class="close" type="button" data-close aria-label="Close dialog"
    >✕</button
  >

  <header class="modal-header">
    <h3 id="modal-title" class="modal-title">{title}</h3>
    {
      tagline && (
        <p class="modal-tagline" id="modal-desc">
          {tagline}
        </p>
      )
    }
  </header>

  <div class="modal-body">
    <slot />
  </div>

  <footer class="modal-footer">
    <div class="spacer"></div>
    <button class="ghost" type="button" data-close>Close</button>
  </footer>
</div>

<style>
  /* Shared project modal overlay, container, and close controls. */
  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(2px);
    touch-action: none;
    z-index: 10;
  }

  .modal {
    position: fixed;
    top: calc(88px + 16px);
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    background: #0e1218;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 18px;
    padding: clamp(18px, 2.2vw, 24px);
    padding-top: clamp(44px, 5vw, 54px);
    max-width: 1000px;
    width: 92vw;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
    z-index: 11;
    box-shadow:
      0 18px 48px rgba(0, 0, 0, 0.5),
      0 0 36px rgba(0, 229, 255, 0.12);
    color: #e6e6e6;
  }

  .close {
    position: absolute;
    top: 14px;
    right: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(11, 17, 24, 0.78);
    border: 1px solid rgba(145, 210, 230, 0.26);
    color: rgba(235, 245, 250, 0.86);
    border-radius: 10px;
    width: 38px;
    height: 38px;
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    backdrop-filter: blur(10px);
    box-shadow:
      0 0 14px rgba(0, 229, 255, 0.08),
      inset 0 0 10px rgba(255, 255, 255, 0.03);
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      color 0.18s ease,
      transform 0.18s ease,
      box-shadow 0.18s ease;
    z-index: 2;
  }

  .close:hover,
  .close:focus-visible {
    color: #ffffff;
    background: rgba(32, 10, 14, 0.9);
    border-color: rgba(255, 95, 95, 0.78);
    box-shadow:
      0 0 12px rgba(255, 80, 80, 0.44),
      0 0 26px rgba(255, 30, 30, 0.18),
      inset 0 0 12px rgba(255, 70, 70, 0.12);
    transform: translateY(-1px);
    outline: none;
  }

  @media (max-width: 700px) {
    .modal {
      top: calc(72px + 12px);
      bottom: 12px;
      width: calc(100vw - 20px);
      border-radius: 14px;
      padding-inline: 14px;
      padding-top: 50px;
    }

    .close {
      top: 12px;
      right: 12px;
      width: 36px;
      height: 36px;
    }
  }

  .modal-title {
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
    font-weight: 800;
  }

  .modal-tagline {
    color: #cbd5e1;
    margin-top: 6px;
  }

  .modal-body {
    display: grid;
    gap: 18px;
    margin-top: 10px;
  }

  .ghost {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: #e6e6e6;
    padding: 10px 14px;
    border-radius: 12px;
    cursor: pointer;
  }
</style>
