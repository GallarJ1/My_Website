---
// Fixed top navigation. Section links are intercepted by BaseLayout's smooth
// one-page navigation, while Resume remains a normal external document link.
const links = [
  { href: "#home", label: "HOME" },
  { href: "#about", label: "ABOUT" },
  { href: "#skills", label: "SKILLS" },
  { href: "#projects", label: "PROJECTS" },
  { href: "#certifications", label: "CERTIFICATIONS" },
  {
    href: "/resume/My_Resume.pdf",
    label: "RESUME",
    external: true,
    specialClass: "resume-link",
  },
];
const pathname = Astro.url.pathname;
---

<header class="navbar">
  <!-- Three-zone layout keeps the nav centered while retaining side affordances. -->
  <div class="nav-shell">
    <div class="nav-left-zone">
      <span class="drag-hint">DRAG ANYWHERE</span>
    </div>

    <nav class="nav-links">
      {
        links.map((l) => (
          <a
            href={l.href}
            class={
              "nav-link" +
              (pathname === l.href ? " active" : "") +
              (l.specialClass ? ` ${l.specialClass}` : "")
            }
            target={l.external ? "_blank" : undefined}
            rel={l.external ? "noopener noreferrer" : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-right-zone">
      <a href="#contact" class="contact-chip">CONTACT</a>
    </div>
  </div>
</header>
