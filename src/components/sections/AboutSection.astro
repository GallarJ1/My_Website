---
// About section: animated identity scan followed by personal story cards.
---

<section class="about-scan-wrap js-about-scan">
  <!-- Decorative glyph burst used during the scan animation. -->
  <div class="bg-burst" aria-hidden="true">
    <span class="burst-char burst-1">0</span>
    <span class="burst-char burst-2">1</span>
    <span class="burst-char burst-3"
      >{}
      <span class="burst-char burst-4"></span></span
    >
    <span class="burst-char burst-5">#</span>
    <span class="burst-char burst-6">$</span>
    <span class="burst-char burst-7">&lt;</span>
    <span class="burst-char burst-8">&gt;</span>
    <span class="burst-char burst-9">1</span>
    <span class="burst-char burst-10">0</span>
    <span class="burst-char burst-11">[</span>
    <span class="burst-char burst-12">]</span>
  </div>

  <!-- Terminal-style identity scan panel. -->
  <div class="scan-panel">
    <div class="scan-topbar">
      <span class="scan-dot scan-dot-red"></span>
      <span class="scan-dot scan-dot-yellow"></span>
      <span class="scan-dot scan-dot-green"></span>
      <p class="scan-title">identity-scan.sys</p>
    </div>

    <div class="scan-body">
      <div class="scan-grid"></div>
      <div class="scan-line"></div>

      <p class="scan-text delay-1">SCANNING USER...</p>
      <p class="scan-text delay-2">MATCH FOUND</p>

      <div class="scan-profile delay-3">
        <h2 class="scan-name">Jeremy Gallardo</h2>
        <p>Regional IT Systems Manager</p>
        <p>Serving IT Infastructure since 2020</p>
        <p>Infrastructure / Cloud / Automation</p>
        <p class="scan-status">STATUS: VERIFIED<span class="cursor">_</span></p>
      </div>
    </div>
  </div>

  <!-- Story and working-style content cards. -->
  <div class="scan-content">
    <article class="scan-card reveal-1">
      <span class="card-trace card-trace-top-left"></span>
      <span class="card-trace card-trace-top-right"></span>
      <span class="card-trace card-trace-side-left"></span>
      <span class="card-trace card-trace-side-right"></span>

      <p class="card-label">MY STORY</p>
      <h3>Built from curiosity.</h3>

      <p>
        My interest in technology started early when I saved up for my first
        budget PC and learned how to build it myself. That hands-on experience
        sparked a deeper interest in how systems work, how they fail, and how
        they can be improved.
      </p>

      <p>
        Over time, that curiosity grew into a career centered around
        infrastructure, support, and backend systems. What began with fixing and
        building machines evolved into designing environments that are stable,
        secure, and built to last.
      </p>
    </article>

    <article class="scan-card reveal-2">
      <span class="card-trace card-trace-top-left"></span>
      <span class="card-trace card-trace-top-right"></span>
      <span class="card-trace card-trace-side-left"></span>
      <span class="card-trace card-trace-side-right"></span>

      <p class="card-label">WHAT I DO</p>
      <h3>Keep systems running.</h3>

      <div class="scan-pillars">
        <div class="pillar pillar-1">
          <span class="pillar-title">Infrastructure</span>
          <p>
            I build, maintain, and improve the core systems organizations depend
            on every day.
          </p>
        </div>

        <div class="pillar pillar-2">
          <span class="pillar-title">Automation</span>
          <p>
            I streamline repetitive work and turn manual processes into
            efficient workflows.
          </p>
        </div>

        <div class="pillar pillar-3">
          <span class="pillar-title">Cloud & Hybrid</span>
          <p>
            I work across on-prem and cloud environments to keep systems
            connected, stable, and scalable.
          </p>
        </div>
      </div>
    </article>
  </div>
</section>

<script>
  // Replays the About scan sequence each time the section re-enters view.
  const initAboutScan = () => {
    const section = document.querySelector<HTMLElement>(".js-about-scan");
    if (!section) return;

    let hasEntered = false;

    const resetAnimation = () => {
      section.classList.remove("is-active");
      void section.offsetHeight;
    };

    const playAnimation = () => {
      resetAnimation();
      section.classList.add("is-active");
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        if (!entry) return;

        if (entry.isIntersecting && entry.intersectionRatio > 0.35) {
          if (!hasEntered) {
            hasEntered = true;
            playAnimation();
          }
        } else {
          hasEntered = false;
          resetAnimation();
        }
      },
      {
        threshold: [0, 0.35, 0.6],
      },
    );

    observer.observe(section);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAboutScan, {
      once: true,
    });
  } else {
    initAboutScan();
  }
</script>

<style>
  /* About section shell and animated background glyphs. */
  .about-scan-wrap {
    width: min(1180px, 100%);
    min-height: auto;
    margin: 0 auto;
    position: relative;
    padding-bottom: 32px;
  }

  .about-bottom-grid {
    padding-bottom: 28px;
  }

  .bg-burst {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }

  .burst-char {
    position: absolute;
    font-family: "JetBrains Mono", monospace;
    font-size: clamp(1.15rem, 1.7vw, 1.55rem);
    font-weight: 700;
    color: rgba(210, 255, 90, 0.9);
    text-shadow:
      0 0 10px rgba(210, 255, 90, 0.65),
      0 0 24px rgba(180, 255, 0, 0.55),
      0 0 46px rgba(180, 255, 0, 0.38);
    opacity: 0;
    transform: translateY(0) scale(0.9);
  }

  .burst-1 {
    top: 8%;
    left: 4%;
  }
  .burst-2 {
    top: 14%;
    right: 10%;
  }
  .burst-3 {
    top: 25%;
    left: 18%;
  }
  .burst-4 {
    top: 32%;
    right: 6%;
  }
  .burst-5 {
    top: 46%;
    left: 10%;
  }
  .burst-6 {
    top: 52%;
    right: 20%;
  }
  .burst-7 {
    top: 62%;
    left: 26%;
  }
  .burst-8 {
    top: 70%;
    right: 8%;
  }
  .burst-9 {
    top: 82%;
    left: 8%;
  }
  .burst-10 {
    top: 86%;
    right: 16%;
  }
  .burst-11 {
    top: 58%;
    left: 72%;
  }
  .burst-12 {
    top: 22%;
    left: 76%;
  }

  /* About section scan panel and terminal body. */
  .scan-panel,
  /* About section story cards and pillar list. */
  .scan-content {
    position: relative;
    z-index: 1;
  }

  .scan-panel {
    width: min(920px, 100%);
    margin: 0 auto;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    overflow: hidden;
    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.04),
        rgba(255, 255, 255, 0.015)
      ),
      rgba(8, 10, 18, 0.88);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.02) inset,
      0 18px 60px rgba(0, 0, 0, 0.34);
    backdrop-filter: blur(12px);
  }

  .scan-topbar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.02);
  }

  .scan-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 0 8px rgba(0, 0, 0, 0.16);
  }

  .scan-dot-red {
    background: #ff5f57;
  }
  .scan-dot-yellow {
    background: #febc2e;
  }
  .scan-dot-green {
    background: #28c840;
  }

  .scan-title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.62);
    text-transform: uppercase;
  }

  .scan-body {
    position: relative;
    min-height: 220px;
    padding: 24px 24px 22px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  .scan-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(180, 255, 0, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(180, 255, 0, 0.045) 1px, transparent 1px);
    background-size: 36px 36px;
    opacity: 0.18;
    pointer-events: none;
  }

  .scan-line {
    position: absolute;
    left: 0;
    right: 0;
    top: -26%;
    height: 18%;
    background: linear-gradient(
      to bottom,
      rgba(180, 255, 0, 0),
      rgba(180, 255, 0, 0.08),
      rgba(180, 255, 0, 0.18),
      rgba(180, 255, 0, 0.08),
      rgba(180, 255, 0, 0)
    );
    filter: blur(6px);
    opacity: 0;
    pointer-events: none;
    animation: none !important;
  }

  .scan-text,
  .scan-profile,
  .scan-card {
    opacity: 0;
    transform: translateY(10px);
  }

  .scan-text {
    position: relative;
    z-index: 1;
    margin: 0 0 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: clamp(1rem, 1.2vw, 1.04rem);
    letter-spacing: 0.08em;
    color: #d7ff75;
    text-shadow: 0 0 10px rgba(180, 255, 0, 0.16);
  }

  .scan-profile {
    position: relative;
    z-index: 1;
    margin-top: 18px;
  }

  .scan-profile h2 {
    margin: 0 0 12px;
    font-family: Orbitron, sans-serif;
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.05;
    color: #f1e0ff;
    text-shadow: 0 0 18px rgba(214, 167, 255, 0.14);
  }

  .scan-name {
    position: relative;
    display: inline-block;
  }

  .scan-profile p {
    margin: 0 0 10px;
    font-family: "JetBrains Mono", monospace;
    font-size: clamp(0.98rem, 1.2vw, 1.04rem);
    line-height: 1.75;
    color: rgba(236, 239, 245, 0.9);
  }

  .scan-status {
    margin-top: 16px !important;
    color: #d7ff75 !important;
    letter-spacing: 0.08em;
  }

  .cursor {
    display: inline-block;
    margin-left: 1px;
    opacity: 0;
  }

  .scan-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    align-items: stretch;
  }

  .scan-card {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 24px;
    padding: clamp(20px, 2.4vw, 28px);
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.025),
      rgba(255, 255, 255, 0.01)
    );
    min-height: 100%;
  }

  .card-trace {
    position: absolute;
    pointer-events: none;
    opacity: 0;
    border-radius: 999px;
  }

  .card-trace-top-left,
  .card-trace-top-right {
    top: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      rgba(198, 255, 0, 0),
      rgba(198, 255, 0, 0.95),
      rgba(198, 255, 0, 0)
    );
    box-shadow: 0 0 10px rgba(198, 255, 0, 0.2);
  }

  .card-trace-top-left {
    left: 50%;
    width: 50%;
    transform-origin: left center;
    transform: scaleX(0);
  }

  .card-trace-top-right {
    right: 50%;
    width: 50%;
    transform-origin: right center;
    transform: scaleX(0);
  }

  .card-trace-side-left,
  .card-trace-side-right {
    top: 0;
    width: 2px;
    height: 100%;
    background: linear-gradient(
      180deg,
      rgba(198, 255, 0, 0),
      rgba(198, 255, 0, 0.95),
      rgba(198, 255, 0, 0)
    );
    box-shadow: 0 0 10px rgba(198, 255, 0, 0.2);
    transform-origin: top center;
    transform: scaleY(0);
  }

  .card-trace-side-left {
    left: 0;
  }
  .card-trace-side-right {
    right: 0;
  }

  .card-label {
    margin: 0 0 10px;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    color: var(--accent);
  }

  .scan-card h3 {
    margin: 0 0 18px;
    font-family: Orbitron, sans-serif;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    color: #f1e0ff;
  }

  .scan-card p {
    margin: 0 0 14px;
    font-size: 0.98rem;
    line-height: 1.85;
    color: rgba(232, 235, 240, 0.84);
  }

  .scan-card p:last-child {
    margin-bottom: 0;
  }

  .scan-pillars {
    display: grid;
    gap: 18px;
  }

  .pillar {
    position: relative;
    padding-left: 14px;
    border-left: none;
  }

  .pillar::before {
    content: "";
    position: absolute;
    left: 0;
    top: 2px;
    width: 2px;
    height: calc(100% - 4px);
    background: rgba(198, 255, 0, 0.7);
    transform: scaleY(0);
    transform-origin: top;
    box-shadow: 0 0 10px rgba(198, 255, 0, 0.15);
  }

  .pillar-title {
    display: inline-block;
    margin-bottom: 6px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.03em;
  }

  .pillar p {
    margin: 0;
  }

  /* About section entrance choreography. */
  .about-scan-wrap.is-active .burst-1 {
    animation: burstFloat 1.2s ease-out 0.15s 1 both;
  }
  .about-scan-wrap.is-active .burst-2 {
    animation: burstFloat 1.1s ease-out 0.2s 1 both;
  }
  .about-scan-wrap.is-active .burst-3 {
    animation: burstFloat 1.25s ease-out 0.3s 1 both;
  }
  .about-scan-wrap.is-active .burst-4 {
    animation: burstFloat 1.05s ease-out 0.35s 1 both;
  }
  .about-scan-wrap.is-active .burst-5 {
    animation: burstFloat 1.15s ease-out 0.45s 1 both;
  }
  .about-scan-wrap.is-active .burst-6 {
    animation: burstFloat 1.2s ease-out 0.5s 1 both;
  }
  .about-scan-wrap.is-active .burst-7 {
    animation: burstFloat 1.3s ease-out 0.6s 1 both;
  }
  .about-scan-wrap.is-active .burst-8 {
    animation: burstFloat 1.1s ease-out 0.68s 1 both;
  }
  .about-scan-wrap.is-active .burst-9 {
    animation: burstFloat 1.2s ease-out 0.76s 1 both;
  }
  .about-scan-wrap.is-active .burst-10 {
    animation: burstFloat 1.15s ease-out 0.82s 1 both;
  }
  .about-scan-wrap.is-active .burst-11 {
    animation: burstFloat 1.28s ease-out 0.9s 1 both;
  }
  .about-scan-wrap.is-active .burst-12 {
    animation: burstFloat 1.08s ease-out 0.96s 1 both;
  }

  .about-scan-wrap.is-active .scan-line {
    animation: scanSweep 1.6s ease-out 1 forwards !important;
  }

  .about-scan-wrap.is-active .delay-1 {
    animation: revealUp 0.55s ease forwards;
    animation-delay: 0.12s;
  }

  .about-scan-wrap.is-active .delay-2 {
    animation: revealUp 0.55s ease forwards;
    animation-delay: 0.65s;
  }

  .about-scan-wrap.is-active .delay-3 {
    animation: revealUp 0.7s ease forwards;
    animation-delay: 1.2s;
  }

  .about-scan-wrap.is-active .scan-name {
    animation: nameGlitch 0.62s steps(3, end) 1.38s 1 both;
  }

  .about-scan-wrap.is-active .scan-body::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      circle at center,
      rgba(180, 255, 0, 0.075),
      transparent 62%
    );
    opacity: 0;
    animation: scanPulse 1.15s ease-out 1.55s 1 forwards;
  }

  .about-scan-wrap.is-active .reveal-1 {
    animation: cardReveal 0.7s ease forwards;
    animation-delay: 1.95s;
  }

  .about-scan-wrap.is-active .reveal-2 {
    animation: cardReveal 0.7s ease forwards;
    animation-delay: 2.12s;
  }

  .about-scan-wrap.is-active .pillar-1::before {
    animation: pillarDraw 0.65s ease forwards;
    animation-delay: 2.28s;
  }

  .about-scan-wrap.is-active .pillar-2::before {
    animation: pillarDraw 0.65s ease forwards;
    animation-delay: 2.48s;
  }

  .about-scan-wrap.is-active .pillar-3::before {
    animation: pillarDraw 0.65s ease forwards;
    animation-delay: 2.68s;
  }

  .about-scan-wrap.is-active .reveal-1 .card-trace-top-left,
  .about-scan-wrap.is-active .reveal-2 .card-trace-top-left {
    animation: traceTopLeft 0.45s ease forwards;
    animation-delay: 2.02s;
  }

  .about-scan-wrap.is-active .reveal-1 .card-trace-top-right,
  .about-scan-wrap.is-active .reveal-2 .card-trace-top-right {
    animation: traceTopRight 0.45s ease forwards;
    animation-delay: 2.02s;
  }

  .about-scan-wrap.is-active .reveal-1 .card-trace-side-left,
  .about-scan-wrap.is-active .reveal-2 .card-trace-side-left {
    animation: traceSideDown 0.55s ease forwards;
    animation-delay: 2.42s;
  }

  .about-scan-wrap.is-active .reveal-1 .card-trace-side-right,
  .about-scan-wrap.is-active .reveal-2 .card-trace-side-right {
    animation: traceSideDown 0.55s ease forwards;
    animation-delay: 2.42s;
  }

  .about-scan-wrap.is-active .cursor {
    animation: blink 0.9s steps(1) infinite;
    animation-delay: 1.55s;
    opacity: 1;
  }

  @keyframes burstFloat {
    0% {
      opacity: 0;
      transform: translateY(16px) scale(0.78);
    }
    18% {
      opacity: 1;
      transform: translateY(0) scale(1.08);
      text-shadow:
        0 0 14px rgba(220, 255, 120, 0.8),
        0 0 36px rgba(180, 255, 0, 0.72),
        0 0 72px rgba(180, 255, 0, 0.52);
    }
    55% {
      opacity: 0.95;
      transform: translateY(-8px) scale(1.02);
    }
    100% {
      opacity: 0;
      transform: translateY(-26px) scale(1.18);
    }
  }

  @keyframes scanSweep {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    100% {
      transform: translateY(250px);
      opacity: 0;
    }
  }

  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes cardReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @keyframes nameGlitch {
    0% {
      opacity: 0;
      transform: translateY(10px);
      filter: blur(6px);
      text-shadow:
        -3px 0 rgba(180, 255, 0, 0.22),
        3px 0 rgba(214, 167, 255, 0.22);
    }
    18% {
      opacity: 0.55;
      transform: translateX(-3px);
    }
    38% {
      opacity: 0.82;
      transform: translateX(3px);
      text-shadow:
        3px 0 rgba(180, 255, 0, 0.28),
        -3px 0 rgba(214, 167, 255, 0.24);
    }
    62% {
      opacity: 1;
      transform: translateX(-1px);
      filter: blur(1px);
    }
    100% {
      opacity: 1;
      transform: translateX(0);
      filter: blur(0);
      text-shadow: 0 0 18px rgba(214, 167, 255, 0.14);
    }
  }

  @keyframes scanPulse {
    0% {
      opacity: 0;
      transform: scale(0.985);
    }
    35% {
      opacity: 0.5;
    }
    100% {
      opacity: 0;
      transform: scale(1.03);
    }
  }

  @keyframes pillarDraw {
    from {
      transform: scaleY(0);
      opacity: 0.4;
    }
    to {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @keyframes traceTopLeft {
    from {
      opacity: 1;
      transform: scaleX(0);
    }
    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @keyframes traceTopRight {
    from {
      opacity: 1;
      transform: scaleX(0);
    }
    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @keyframes traceSideDown {
    from {
      opacity: 1;
      transform: scaleY(0);
    }
    to {
      opacity: 1;
      transform: scaleY(1);
    }
  }

  /* About section responsive and accessibility rules. */
  @media (max-width: 920px) {
    .about-scan-wrap {
      min-height: auto;
      align-content: start;
    }

    .scan-content {
      grid-template-columns: 1fr;
    }

    .scan-body {
      min-height: 210px;
    }
  }

  @media (min-width: 921px) and (max-height: 850px) {
    .about-scan-wrap {
      width: min(1060px, 100%);
      padding-bottom: 0;
    }

    .scan-panel {
      width: min(760px, 100%);
      border-radius: 20px;
    }

    .scan-topbar {
      padding: 10px 16px;
    }

    .scan-body {
      min-height: 168px;
      padding: 16px 22px 14px;
    }

    .scan-text {
      margin-bottom: 8px;
      font-size: 0.82rem;
      line-height: 1.35;
    }

    .scan-profile {
      margin-top: 10px;
    }

    .scan-profile h2 {
      margin-bottom: 8px;
      font-size: clamp(1.7rem, 2.6vw, 2.35rem);
    }

    .scan-profile p {
      margin-bottom: 6px;
      font-size: 0.84rem;
      line-height: 1.45;
    }

    .scan-status {
      margin-top: 10px !important;
    }

    .scan-content {
      gap: 14px;
      margin-top: 12px;
    }

    .scan-card {
      border-radius: 20px;
      padding: 16px 20px;
    }

    .card-label {
      margin-bottom: 7px;
      font-size: 0.66rem;
    }

    .scan-card h3 {
      margin-bottom: 10px;
      font-size: clamp(1.15rem, 1.65vw, 1.45rem);
    }

