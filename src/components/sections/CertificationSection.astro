        imgSrc: "/certs/Az_900.png",
        imgAlt: "Microsoft AZ-900 certificate",
        moreUrl:
          "https://learn.microsoft.com/credentials/certifications/azure-fundamentals/",
        summary:
          "Azure core services, governance, security, pricing, and cloud concepts.",
      },

