];

const availableCertImages = new Set([
  "/certs/A_Plus.png",
  "/certs/Az_104.png",
  "/certs/Az_900.png",
  "/certs/ITF.png",
]);

// Flatten provider groups for the card grid and filter metadata.
const allCerts = providers.flatMap((provider) =>
  provider.items.map((item) => ({
    ...item,
    providerKey: provider.key,
    providerLabel: provider.label,
    providerLogo: provider.logo,
    hasImage: Boolean(item.imgSrc && availableCertImages.has(item.imgSrc)),
    filterValues: [provider.label, provider.key, ...item.categories]
      .join("|")
      .toLowerCase(),
  })),
);

const categoryFilters = [
  "All Categories",
  "Security",
  "Cloud",
  "Networking",
  "DevOps",
  "Administration",
  "Support",
  "Foundations",
  "Architecture",
  "Development",
];

const vendorFilters = [
  "All Vendors",
  ...providers.map((provider) => provider.label),
];

// Recruiter-facing summary stats and vendor distribution chart.
const stats = [
  { label: "Certifications", value: allCerts.length },
  { label: "Vendors", value: providers.length },
];

const maxVendorCerts = Math.max(
  ...providers.map((provider) => provider.items.length),
);

const vendorDistribution = providers.map((provider) => ({
  key: provider.key,
  label: provider.label,
  logo: provider.logo,
  count: provider.items.length,
  width: Math.max(8, Math.round((provider.items.length / maxVendorCerts) * 100)),
}));
---

<section class="cert-dashboard" aria-label="Certifications dashboard">
  <!-- Ambient code symbols for the Certifications visual theme. -->
  <div class="cert-backdrop" aria-hidden="true">
    <span>01</span>
    <span>{"{}"}</span>
    <span>AZ</span>
    <span>SEC</span>
    <span>CLF</span>
    <span>NET</span>
    <span>102</span>
    <span>{"</>"}</span>
  </div>

  <!-- Page intro and quick breadth summary. -->
  <header class="cert-header reveal-item">
    <div>
      <h2>Certifications</h2>
      <p>
        Vendor-verified credentials across cloud, security, networking,
        endpoint administration, and DevOps.
      </p>
    </div>
  </header>

  <div class="summary-grid" aria-label="Certification summary">
    <div class="stats-grid">
      {
        stats.map((stat) => (
          <div class="stat-card reveal-item">
            <strong class="stat-number" data-count={stat.value}>0</strong>
            <span>{stat.label}</span>
          </div>
        ))
      }
    </div>

    <div class="vendor-distribution reveal-item" aria-label="Certifications by vendor">
      <div class="distribution-head">
        <h3>Vendor Distribution</h3>
        <span>{providers.length} vendors</span>
      </div>

      <div class="distribution-list">
        {
          vendorDistribution.map((vendor) => (
            <div class="distribution-row">
              <div class="distribution-label">
                <img src={vendor.logo} alt="" loading="lazy" />
                <span>{vendor.label}</span>
              </div>

              <div class="distribution-track" aria-hidden="true">
                <span style={`--bar-width: ${vendor.width}%`}></span>
              </div>

              <strong>{vendor.count}</strong>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Filterable credential library. Cards are generated from allCerts. -->
  <section class="cert-browser" aria-label="All certifications">
    <div class="browser-toolbar reveal-item">
      <div class="section-heading">
        <h3>Credential Library</h3>
        <span id="certResultCount">{allCerts.length} shown</span>
      </div>

      <div class="filter-controls" aria-label="Filter certifications">
        <label class="filter-field">
          <span>Category</span>
          <select id="certCategoryFilter">
            {
              categoryFilters.map((filter) => (
                <option value={filter}>{filter}</option>
              ))
            }
          </select>
        </label>

        <label class="filter-field">
          <span>Vendor</span>
          <select id="certVendorFilter">
            {
              vendorFilters.map((filter) => (
                <option value={filter}>{filter}</option>
              ))
            }
          </select>
        </label>
      </div>
    </div>

    <div class="cert-grid" id="certGrid">
      {
        allCerts.map((cert) => (
          <article
            class="cert-card compact reveal-item"
            data-provider={cert.providerLabel}
            data-categories={cert.categories.join(" ")}
            data-filter-values={cert.filterValues}
            data-vendor-value={cert.providerLabel.toLowerCase()}
            data-category-values={cert.categories.join("|").toLowerCase()}
          >
            <div class="scan-line" aria-hidden="true"></div>

            <div class="card-topline">
              <span class="vendor-mark">
                <img src={cert.providerLogo} alt="" loading="lazy" />
                {cert.providerLabel}
              </span>
              <span class="status">
                <i aria-hidden="true"></i>
                {cert.status}
              </span>
            </div>

            <h4>{cert.title}</h4>

            {
              cert.hasImage && (
                <button
                  class="cert-preview"
                  type="button"
                  data-cert-image={cert.imgSrc}
                  data-cert-alt={cert.imgAlt}
                  data-cert-title={cert.title}
                  aria-label={`Expand ${cert.title} certificate image`}
                >
                  <img src={cert.imgSrc} alt={cert.imgAlt} loading="lazy" />
                </button>
              )
            }

            <p>{cert.summary}</p>

            <div class="tag-row">
              {cert.categories.slice(0, 3).map((category) => (
                <span>{category}</span>
              ))}
            </div>

            <div class="card-footer">
              <a href={cert.moreUrl} target="_blank" rel="noopener noreferrer">
                View Credential Source
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</section>

<!-- Image preview modal opened by certificate thumbnail buttons. -->
<dialog class="cert-modal" id="certModal" aria-labelledby="certModalTitle">
  <div class="modal-shell">
    <div class="modal-head">
      <h3 id="certModalTitle">Certificate</h3>
      <button class="modal-close" type="button" aria-label="Close certificate preview">
        Close
      </button>
    </div>
    <img id="certModalImage" src="" alt="" />
  </div>
</dialog>

<script is:inline>
  // Certifications interactions: entrance animation, count-up stats,
  // two-select filtering, and certificate image modal preview.
  const initCertDashboard = () => {
    const dashboard = document.querySelector(".cert-dashboard");
    if (!dashboard) return;
    if (dashboard.dataset.ready === "true") return;
    dashboard.dataset.ready = "true";

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const revealItems = [...dashboard.querySelectorAll(".reveal-item")];
    const statNumbers = [...dashboard.querySelectorAll(".stat-number")];
    const categoryFilter = dashboard.querySelector("#certCategoryFilter");
    const vendorFilter = dashboard.querySelector("#certVendorFilter");
    const cards = [...dashboard.querySelectorAll(".cert-grid .cert-card")];
    const resultCount = dashboard.querySelector("#certResultCount");
    const modal = document.querySelector("#certModal");
    const modalImage = document.querySelector("#certModalImage");
    const modalTitle = document.querySelector("#certModalTitle");
    const modalClose = document.querySelector(".modal-close");
    let statsAnimated = false;

    revealItems.forEach((item, index) => {
      item.style.setProperty("--reveal-delay", `${Math.min(index * 55, 520)}ms`);
    });

    const animateStats = () => {
      if (statsAnimated) return;
      statsAnimated = true;

      statNumbers.forEach((number) => {
        const end = Number(number.dataset.count || 0);
        if (prefersReducedMotion) {
          number.textContent = String(end);
          return;
        }

        const duration = 850;
        const start = performance.now();

        const tick = (now) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          number.textContent = String(Math.round(end * eased));

          if (progress < 1) requestAnimationFrame(tick);
        };

        requestAnimationFrame(tick);
      });
    };

    const showDashboard = () => {
      dashboard.classList.add("is-visible");
      animateStats();
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              showDashboard();
              observer.disconnect();
            }
          });
        },
        { threshold: 0.12 },
      );

      observer.observe(dashboard);
    } else {
      showDashboard();
    }

    const normalizeFilter = (value, allLabel) =>
      value === allLabel ? "all" : value.toLowerCase();

    const setFilters = () => {
      const selectedCategory = normalizeFilter(
        categoryFilter?.value || "All Categories",
        "All Categories",
      );
      const selectedVendor = normalizeFilter(
        vendorFilter?.value || "All Vendors",
        "All Vendors",
      );
      let visibleCount = 0;

      cards.forEach((card, index) => {
        const categoryValues = (card.dataset.categoryValues || "")
          .toLowerCase()
          .split("|");
        const vendorValue = (card.dataset.vendorValue || "").toLowerCase();
        const matchesCategory =
          selectedCategory === "all" ||
          categoryValues.includes(selectedCategory);
        const matchesVendor =
          selectedVendor === "all" || vendorValue === selectedVendor;
        const matches = matchesCategory && matchesVendor;

        if (matches) {
          visibleCount += 1;
          card.hidden = false;
          card.style.setProperty("--filter-delay", `${Math.min(index * 35, 260)}ms`);
          requestAnimationFrame(() => {
            card.classList.remove("is-filtered-out");
            card.classList.add("is-filtered-in");
          });
        } else {
          card.classList.remove("is-filtered-in");
          card.classList.add("is-filtered-out");
          window.setTimeout(() => {
            if (card.classList.contains("is-filtered-out")) card.hidden = true;
          }, prefersReducedMotion ? 0 : 220);
        }
      });

      if (resultCount) resultCount.textContent = `${visibleCount} shown`;
    };

    categoryFilter?.addEventListener("change", setFilters);
    vendorFilter?.addEventListener("change", setFilters);

    dashboard.addEventListener("click", (event) => {
      const preview = event.target.closest("[data-cert-image]");
      if (!preview || !modal || !modalImage || !modalTitle) return;

      modalImage.src = preview.dataset.certImage || "";
      modalImage.alt = preview.dataset.certAlt || "";
      modalTitle.textContent = preview.dataset.certTitle || "Certificate";

      if (typeof modal.showModal === "function") {
        modal.showModal();
      }
    });

    modalClose?.addEventListener("click", () => modal?.close());
    modal?.addEventListener("click", (event) => {
      if (event.target === modal) modal.close();
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCertDashboard);
  } else {
    initCertDashboard();
  }
</script>

<style>
  /* Certifications section design system and layout. */
  .cert-dashboard {
    --cert-accent: 0 140 255;
    --cert-cyan: 0 255 220;
    --cert-green: 165 255 40;
    --cert-surface: rgba(6, 12, 16, 0.78);
    --cert-surface-strong: rgba(8, 16, 22, 0.9);
    --cert-border: rgba(var(--cert-accent) / 0.28);
    --cert-text: #edf7ff;
    --cert-muted: rgba(224, 235, 245, 0.68);

    position: relative;
    width: min(1180px, 100%);
    margin: 0 auto;
    padding: clamp(1rem, 2.5vw, 2.25rem) 0 3rem;
    color: var(--cert-text);
    isolation: isolate;
  }

  .cert-dashboard::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(
        circle at 50% 0%,
        rgba(var(--cert-accent) / 0.13),
        transparent 34rem
      ),
      radial-gradient(
        circle at 15% 68%,
        rgba(var(--cert-cyan) / 0.06),
        transparent 24rem
      ),
      radial-gradient(
        circle at 84% 40%,
        rgba(var(--cert-green) / 0.04),
        transparent 18rem
      );
    pointer-events: none;
  }

  /* Certifications: ambient drifting symbols. */
  .cert-backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    opacity: 0.45;
  }

  .cert-backdrop span {
    position: absolute;
    color: rgba(var(--cert-green) / 0.22);
    font-family: var(--font-mono, "JetBrains Mono", ui-monospace, monospace);
    font-size: clamp(0.75rem, 1vw, 1.1rem);
    text-shadow: 0 0 14px rgba(var(--cert-green) / 0.22);
    animation: codeDrift 18s linear infinite;
  }

  .cert-backdrop span:nth-child(1) {
    left: 7%;
    top: 18%;
    animation-duration: 19s;
  }

  .cert-backdrop span:nth-child(2) {
    left: 91%;
    top: 10%;
    animation-duration: 22s;
    animation-delay: -6s;
  }

  .cert-backdrop span:nth-child(3) {
    left: 66%;
    top: 24%;
    animation-duration: 17s;
    animation-delay: -10s;
  }

  .cert-backdrop span:nth-child(4) {
    left: 18%;
    top: 76%;
    animation-duration: 21s;
    animation-delay: -3s;
  }

  .cert-backdrop span:nth-child(5) {
    left: 86%;
    top: 70%;
    animation-duration: 24s;
    animation-delay: -12s;
  }

  .cert-backdrop span:nth-child(6) {
    left: 35%;
    top: 36%;
    animation-duration: 16s;
    animation-delay: -8s;
  }

  .cert-backdrop span:nth-child(7) {
    left: 52%;
    top: 88%;
    animation-duration: 20s;
    animation-delay: -14s;
  }

  .cert-backdrop span:nth-child(8) {
    left: 4%;
    top: 54%;
    animation-duration: 23s;
    animation-delay: -5s;
  }

  @keyframes codeDrift {
    0% {
      transform: translate3d(0, 18px, 0);
      opacity: 0;
    }

    18%,
    72% {
      opacity: 1;
    }

    100% {
      transform: translate3d(0, -48px, 0);
      opacity: 0;
    }
  }

  /* Certifications: intro, heading, and shared section headings. */
  .cert-header,
  .browser-toolbar,
  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .cert-header {
    margin-bottom: 1rem;
  }

  .cert-header h2,
  .section-heading h3,
  .cert-card h4 {
    font-family: var(--font-orbitron, "Orbitron", ui-sans-serif, system-ui);
    letter-spacing: 0.02em;
    margin: 0;
  }

  .cert-header h2 {
    font-size: clamp(2rem, 5vw, 3.8rem);
    line-height: 1;
    text-shadow: 0 0 22px rgba(var(--cert-accent) / 0.22);
  }

  .cert-header p {
    max-width: 680px;
    margin: 0.85rem 0 0;
    color: var(--cert-muted);
    line-height: 1.65;
    font-size: clamp(0.9rem, 1vw, 1rem);
  }

  .cert-card a,
  .filter-field select {
    border: 1px solid rgba(var(--cert-accent) / 0.4);
    background: rgba(255, 255, 255, 0.035);
    color: #f4fbff;
    font-family: var(--font-mono, "JetBrains Mono", ui-monospace, monospace);
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease,
      box-shadow 0.18s ease,
      color 0.18s ease;
  }

  .cert-card a:hover,
  .cert-card a:focus-visible,
  .filter-field select:hover,
  .filter-field select:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(var(--cert-accent) / 0.85);
    background: rgba(var(--cert-accent) / 0.1);
    box-shadow: 0 0 20px rgba(var(--cert-accent) / 0.2);
    outline: none;
  }

  /* Certifications: summary cards and vendor distribution graph. */
  .summary-grid {
    display: grid;
    grid-template-columns: minmax(260px, 0.72fr) minmax(0, 1.28fr);
    gap: 0.8rem;
    margin-bottom: 1.35rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .stat-card {
    position: relative;
    min-height: 96px;
    padding: 1rem;
    overflow: hidden;
    border: 1px solid rgba(var(--cert-accent) / 0.26);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.055), transparent 55%),
      rgba(6, 11, 14, 0.72);
    box-shadow:
      inset 0 0 20px rgba(0, 0, 0, 0.35),
      0 0 28px rgba(var(--cert-accent) / 0.06);
  }

  .stat-card::after {
    content: "";
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(var(--cert-cyan) / 0.76),
      transparent
    );
    opacity: 0.8;
  }

  .stat-card strong {
    display: block;
    font-family: var(--font-orbitron, "Orbitron", ui-sans-serif, system-ui);
    font-size: clamp(1.85rem, 4vw, 2.7rem);
    line-height: 1;
    color: #ffffff;
  }

  .stat-card span {
    display: block;
