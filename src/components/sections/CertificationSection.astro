---

<!-- Accent for this section -->
<style is:global>
  :root {
    --accent: 0 120 255;
  }
</style>

<div class="wrap">
  <div class="controls">
    <button id="expandAll" class="chip" type="button">Expand all</button>
    <button id="collapseAll" class="chip" type="button">Collapse all</button>
  </div>

  <section class="accordions">
    {
      providers.map((p) => (
        <details class="prov" id={p.key} data-key={p.key}>
          <summary class="prov-head">
            <span class="title-wrap">
              {p.logo && <img class="brand" src={p.logo} alt="" />}
              <span class="label glow">{p.label}</span>
            </span>

            <span class="right">
              <span class="count">{p.items.length}</span>
              <span class="caret">▾</span>
            </span>
          </summary>

          <div class="panel">
            <div class="grid">
              {p.items.map((c) => (
                <CertCard {...c} />
              ))}
            </div>
          </div>
        </details>
      ))
    }
  </section>
</div>

<script is:inline>
  const detailsEls = Array.from(document.querySelectorAll(".prov"));

  function animatePanel(detailsEl, open) {
    const panel = detailsEl.querySelector(".panel");
    if (!panel) return;
    const start = panel.offsetHeight;
    panel.style.height = "auto";
    const end = panel.offsetHeight;
    panel.style.height = start + "px";
    requestAnimationFrame(() => {
      panel.style.height = (open ? end : 0) + "px";
    });
  }

  detailsEls.forEach((d) => {
    if (!d.open) {
      const panel = d.querySelector(".panel");
      if (panel) panel.style.height = "0px";
    }
    d.addEventListener("toggle", () => animatePanel(d, d.open));
  });

  document.getElementById("expandAll")?.addEventListener("click", () => {
    detailsEls.forEach((d) => {
      if (!d.open) {
        d.open = true;
        animatePanel(d, true);
      }
    });
  });

  document.getElementById("collapseAll")?.addEventListener("click", () => {
    detailsEls.forEach((d) => {
      if (d.open) {
        animatePanel(d, false);
        d.open = false;
      }
    });
  });

  // Deep-link support: #microsoft, #comptia, etc.
  const hash = window.location.hash?.slice(1);

  if (hash) {
    const target = document.getElementById(hash);

    if (target && target.tagName.toLowerCase() === "details") {
      target.open = true;

      const panel = target.querySelector(".panel");
      if (panel) panel.style.height = "auto";

      // Delay scroll slightly so layout is ready
      setTimeout(() => {
        target.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      }, 100);
    }
  }
</script>

<style>
  .wrap {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    min-height: auto;
    padding: 0 1rem 2.5rem;
    display: grid;
    gap: 1.25rem;
    box-sizing: border-box;
    background:
      radial-gradient(
        60% 40% at 50% 0%,
        rgba(var(--accent) / 0.07),
        transparent 70%
      ),
      radial-gradient(
        40% 30% at 30% 100%,
        rgba(0, 255, 200, 0.03),
        transparent 70%
      ),
      radial-gradient(
        30% 30% at 80% 70%,
        rgba(0, 180, 255, 0.03),
        transparent 70%
      );
  }

  .accordions {
    width: 100%;
    max-width: 1060px;
    margin: 0 auto;
    display: grid;
    gap: 1rem;
  }

  /* Center the controls */
  .controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
    margin: 0 auto 0.5rem;
  }
  .chip {
    padding: 0.65rem 1rem;
    border-radius: 999px;
    cursor: pointer;
    border: 1px solid rgba(var(--accent) / 0.35);
    background: rgba(255 255 255 / 0.03);
    color: #eaf3ff;
    font-family: var(--font-mono, "JetBrains Mono", ui-monospace, monospace);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .chip:hover,
  .chip:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(var(--accent) / 0.85);
    box-shadow: 0 0 18px rgba(var(--accent) / 0.25);
    background: rgba(var(--accent) / 0.07);
    outline: none;
  }

  .prov {
    border: 1px solid rgba(var(--accent) / 0.3);
    border-radius: 18px;
    background: rgba(10, 14, 16, 0.55);
    backdrop-filter: blur(6px);
    overflow: clip;
    transition:
      box-shadow 0.25s ease,
      border-color 0.25s ease,
      background 0.25s ease,
      transform 0.2s ease;
    will-change: transform;
  }

  /* Expand-on-hover for desktop */
  @media (hover: hover) {
    .prov:hover {
      transform: translateY(-2px);
      box-shadow:
        0 0 42px rgba(var(--accent) / 0.12),
        inset 0 0 20px rgba(0, 0, 0, 0.35);
      border-color: rgba(var(--accent) / 0.5);
    }
  }

  /* Bigger collapsed strip */
  .prov-head {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.9rem;
    padding: 1.25rem 1.4rem;
    min-height: 84px;
    cursor: pointer;
    user-select: none;
  }

  .title-wrap {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }
  .brand {
    width: 28px;
    height: 28px;
    object-fit: contain;
    filter: drop-shadow(0 0 6px rgba(var(--accent) / 0.25));
    opacity: 0.95;
  }

  .label {
    font-weight: 800;
    letter-spacing: 0.35px;
    font-family: var(--font-orbitron, "Orbitron", ui-sans-serif, system-ui);
    font-size: clamp(1.1rem, 0.95rem + 0.8vw, 1.45rem);
    color: #eaf3ff;
  }

  /* Gentle fade-in/out glow on the provider title */
  .glow {
    text-shadow:
      0 0 8px rgba(var(--accent) / 0.35),
      0 0 16px rgba(var(--accent) / 0.22);
    animation: titleGlow 3s ease-in-out infinite;
  }
  @keyframes titleGlow {
    0% {
      text-shadow:
        0 0 6px rgba(var(--accent) / 0.22),
        0 0 12px rgba(var(--accent) / 0.12);
      opacity: 0.95;
    }
    50% {
      text-shadow:
        0 0 16px rgba(var(--accent) / 0.55),
        0 0 28px rgba(var(--accent) / 0.3);
      opacity: 1;
    }
    100% {
      text-shadow:
        0 0 6px rgba(var(--accent) / 0.22),
        0 0 12px rgba(var(--accent) / 0.12);
      opacity: 0.95;
    }
  }

  .right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .count {
    font-family: var(--font-mono, "JetBrains Mono", ui-monospace, monospace);
    padding: 0.25rem 0.6rem;
    border: 1px solid rgba(var(--accent) / 0.4);
    border-radius: 999px;
    background: rgba(255 255 255 / 0.03);
    color: #eaf3ff;
  }
  .caret {
    transition: transform 0.2s ease;
    opacity: 0.9;
  }
  .prov[open] .caret {
    transform: rotate(180deg);
  }

  /* Animated panel wrapper */
  .panel {
    height: auto; /* JS sets to 0px when closed */
    overflow: hidden;
    transition: height 0.35s ease;
  }

  .grid {
    display: grid;
    gap: 1rem;
    padding: 0 1rem 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Keyboard focus ring on summary */
  .prov-head:focus {
    outline: none;
  }
  .prov-head:focus-visible {
    box-shadow: inset 0 0 0 2px rgba(var(--accent) / 0.75);
    border-radius: 12px;
  }

  @media (prefers-reduced-motion: reduce) {
    .glow {
      animation: none;
    }
    .panel {
      transition: none;
    }
    .prov:hover {
      transform: none;
    }
  }
</style>
