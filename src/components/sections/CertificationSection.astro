        title: "AZ-104 — Azure Administrator Associate",
        imgSrc: "/certs/Az_104.png",
        imgAlt: "Microsoft AZ-104 certificate",
        moreUrl:
          "https://learn.microsoft.com/credentials/certifications/azure-administrator/",
        summary:
          "Identity, governance, storage, compute, networking in Azure with automation focus.",
      },

      {
