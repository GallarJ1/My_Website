---
// Contact section: all external profile/contact targets in one data list.
import LinkBubble from "../LinkBubble.astro";

const NAME = "Jeremy Gallardo";
const HEADSHOT = "/images/my-image.png";
const RESUME = "/resume/My_Resume.pdf";
const EMAIL = "jeremy.n.gallardo@gmail.com";
const LINKEDIN = "https://www.linkedin.com/in/jeremy-nicolas-gallardo/";
const GITHUB = "https://github.com/GallarJ1";
const UPWORK = "https://www.upwork.com/freelancers/~0145909b0625062c4e";

const links = [
  { label: "Email Me", icon: "✉️", href: `mailto:${EMAIL}`, external: false },
  { label: "LinkedIn Profile", icon: "💼", href: LINKEDIN, external: true },
  { label: "View My Resume", icon: "📄", href: RESUME, external: true },
  { label: "My GitHub", icon: "🛠️", href: GITHUB, external: true },
  { label: "Work With Me", icon: "🤝", href: UPWORK, external: true },
];
---

<div class="wrap">
  <!-- Centered contact card with staggered link rows. -->
  <section class="card">
    <img src={HEADSHOT} alt={`${NAME} headshot`} class="avatar" />
    <h1 class="name">{NAME}</h1>

    <div class="links">
      {
        links.map((l, i) => (
          <div class="row" style={`animation-delay:${80 * i}ms`}>
            <LinkBubble {...l} />
          </div>
        ))
      }
    </div>
  </section>
</div>

<style>
  /* Contact section layout. Link-specific styling lives in LinkBubble.astro. */
  .wrap {
    min-height: auto;
    display: grid;
    place-items: start center;
    padding: 0 1rem 2rem;
    background:
      radial-gradient(
        60% 40% at 50% 0%,
        rgba(0, 255, 200, 0.06),
        transparent 70%
      ),
      radial-gradient(
        40% 30% at 30% 100%,
        rgba(150, 0, 255, 0.05),
        transparent 70%
      ),
      radial-gradient(
        30% 30% at 80% 70%,
        rgba(0, 180, 255, 0.04),
        transparent 70%
      );
  }

  .card {
    width: 100%;
    max-width: 520px;
    display: grid;
    justify-items: stretch;
    gap: 1rem;
    text-align: center;
    padding: 2.2rem 1.4rem 2.4rem;
    border-radius: 1.25rem;
    border: 1px solid rgba(0, 255, 200, 0.25);
    background: rgba(10, 14, 16, 0.55);
    box-shadow:
      0 0 40px rgba(0, 255, 200, 0.08),
      inset 0 0 32px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(6px);
  }

  .links {
    width: 100%;
    display: grid;
    gap: 0.8rem;
    margin-top: 0.2rem;
  }

  .row {
    width: 100%;
    display: block;
    opacity: 0;
    transform: translateY(6px);
    animation: rise 0.5s ease forwards;
  }

  .avatar {
    width: 104px;
    height: 104px;
    border-radius: 999px;
    object-fit: cover;
    border: 2px solid rgba(0, 255, 200, 0.55);
    box-shadow: 0 0 22px rgba(0, 255, 200, 0.45);
    justify-self: center;
  }

  .name {
    margin: 0.2rem 0 1rem;
    font-family: var(--font-orbitron, "Orbitron", ui-sans-serif, system-ui);
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 640px) {
    .card {
      padding: 2.6rem 2rem 2.8rem;
    }
  }

  @media (min-width: 901px) and (max-height: 850px) {
    .wrap {
      padding-bottom: 1.25rem;
    }

    .card {
      max-width: 480px;
      gap: 0.75rem;
      padding: 1.7rem 1.8rem 1.9rem;
    }

    .avatar {
      width: 88px;
      height: 88px;
    }

    .name {
      margin-bottom: 0.6rem;
      font-size: 1.65rem;
    }

    .links {
      gap: 0.65rem;
    }
  }

  @media (min-width: 901px) and (max-height: 720px) {
    .wrap {
      padding-bottom: 0.75rem;
    }

    .card {
      max-width: 430px;
      gap: 0.55rem;
      padding: 1.25rem 1.45rem 1.45rem;
      border-radius: 1rem;
    }

    .avatar {
      width: 72px;
      height: 72px;
    }

    .name {
      margin: 0.1rem 0 0.4rem;
      font-size: 1.35rem;
    }

    .links {
      gap: 0.5rem;
    }
  }
</style>
